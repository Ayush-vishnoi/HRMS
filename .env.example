DATABASE_URL=""
REDIS_URL=rediss://default:xxxxx@xxxxx.upstash.io:6379

# --- Real email delivery via Resend (optional) ---
# Signup at https://resend.com (free tier: 100 emails/day), create an API key,
# and verify your sending domain. Without these vars the app runs in
# adapter-ready mode (emails are logged to console only).
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# RESEND_DOMAIN="yourdomain.com"          # used to build the from address
# EMAIL_FROM="HRMS <onboarding@yourdomain.com>"  # explicit from override
# NEXT_PUBLIC_APP_URL="http://localhost:3000"    # used for candidate portal links
