# PostgreSQL connection string (required)
# Local example: postgresql://postgres:postgres@localhost:5432/hrms?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hrms?schema=public"

# Secret used to sign JWT auth tokens (required) — use a long random string.
# Must match JWT_SECRET in the frontend .env.local
JWT_SECRET="change-me-to-a-long-random-string"

# Port the NestJS backend listens on (default 4000)
BACKEND_PORT=4000

# URL of the Next.js frontend (used for CORS / links)
FRONTEND_URL=http://localhost:3000
