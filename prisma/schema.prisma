model Conversation {
  id             String   @id @default(cuid()) @db.VarChar(36)
  participant1Id String   @map("participant_1_id") @db.VarChar(36)
  participant2Id String   @map("participant_2_id") @db.VarChar(36)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  participant1 Employee  @relation("ConversationParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2 Employee  @relation("ConversationParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([participant1Id, participant2Id], map: "uq_conversation_participants")
  @@index([participant1Id])
  @@index([participant2Id])
  @@map("conversations")
}

enum MessageStatus {
  SENT
  DELIVERED
  SEEN
}

model Message {
  id             String        @id @default(cuid()) @db.VarChar(36)
  conversationId String        @map("conversation_id") @db.VarChar(36)
  senderId       String        @map("sender_id") @db.VarChar(36)
  receiverId     String        @map("receiver_id") @db.VarChar(36)
  content        String        @db.Text
  status         MessageStatus @default(SENT)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Employee     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     Employee     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([receiverId, status])
  @@map("messages")
}



