  workforce_projects                          workforce_projects? @relation(fields: [project_id], references: [id])
  employees_timesheets_reviewer_idToemployees Employee?           @relation("timesheets_reviewer_idToemployees", fields: [reviewer_id], references: [id])

  @@index([employee_id, work_date])
  @@index([project_id, work_date])
  @@index([reviewer_id, status])
}

model work_locations {
