generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                                                                                           String                               @id @default(cuid()) @db.VarChar(36)
  employeeCode                                                                                 String                               @unique @map("employee_code") @db.VarChar(30)
  name                                                                                         String                               @db.VarChar(120)
  email                                                                                        String                               @unique @db.VarChar(150)
  passwordHash                                                                                 String?                              @map("password_hash") @db.VarChar(255)
  roleTitle                                                                                    String                               @map("role_title") @db.VarChar(100)
  userRole                                                                                     UserRole                             @default(employee) @map("user_role")
  department                                                                                   String                               @db.VarChar(80)
  phone                                                                                        String?                              @db.VarChar(30)
  avatarUrl                                                                                    String?                              @map("avatar_url")
  status                                                                                       EmploymentStatus                     @default(Active)
  joinDate                                                                                     String                               @map("join_date") @db.VarChar(30)
  location                                                                                     String                               @db.VarChar(120)
  salary                                                                                       Decimal                              @default(0.00) @db.Decimal(12, 2)
  managerId                                                                                    String?                              @map("manager_id") @db.VarChar(36)
  createdAt                                                                                    DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                                                    DateTime                             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  failedLoginAttempts                                                                          Int                                  @default(0) @map("failed_login_attempts")
  lockedUntil                                                                                  DateTime?                            @map("locked_until")
  lastLoginAt                                                                                  DateTime?                            @map("last_login_at")
  organization_id                                                                              String?
  business_unit_id                                                                             String?
  department_id                                                                                String?
  designation_id                                                                               String?
  work_location_id                                                                             String?
  assignedAssets                                                                               Asset[]                              @relation("AssetAssignee")
  attendanceRecords                                                                            AttendanceRecord[]
  authAccounts                                                                                 AuthAccount[]
  authSessions                                                                                 AuthSession[]
  business_units_business_units_head_employee_idToemployees                                    business_units[]                     @relation("business_units_head_employee_idToemployees")
  candidate_notes                                                                              candidate_notes[]
  publishedPolicies                                                                            CompanyPolicy[]                      @relation("PolicyPublisher")
  departments_departments_head_employee_idToemployees                                          departments[]                        @relation("departments_head_employee_idToemployees")
  documentRequests                                                                             DocumentRequest[]
  document_signatures                                                                          document_signatures[]
  document_templates_document_templates_created_by_idToemployees                               DocumentTemplate[]                   @relation("document_templates_created_by_idToemployees")
  document_templates_document_templates_updated_by_idToemployees                               DocumentTemplate[]                   @relation("document_templates_updated_by_idToemployees")
  employee_change_approvals                                                                    employee_change_approvals[]
  employee_change_requests_employee_change_requests_employee_idToemployees                     employee_change_requests[]           @relation("employee_change_requests_employee_idToemployees")
  employee_change_requests_employee_change_requests_from_manager_idToemployees                 employee_change_requests[]           @relation("employee_change_requests_from_manager_idToemployees")
  employee_change_requests_employee_change_requests_requested_by_idToemployees                 employee_change_requests[]           @relation("employee_change_requests_requested_by_idToemployees")
  employee_change_requests_employee_change_requests_to_manager_idToemployees                   employee_change_requests[]           @relation("employee_change_requests_to_manager_idToemployees")
  documents                                                                                    EmployeeDocument[]
  employee_employment_profiles                                                                 employee_employment_profiles?
  employeeOffboarding                                                                          EmployeeOffboarding?                 @relation("OffboardedEmployee")
  offboardingsPerformed                                                                        EmployeeOffboarding[]                @relation("OffboardingAdministrator")
  employee_onboardings_employee_onboardings_buddy_employee_idToemployees                       EmployeeOnboarding[]                 @relation("employee_onboardings_buddy_employee_idToemployees")
  employeeOnboarding                                                                           EmployeeOnboarding?                  @relation("OnboardedEmployee")
  employee_onboardings_employee_onboardings_manager_employee_idToemployees                     EmployeeOnboarding[]                 @relation("employee_onboardings_manager_employee_idToemployees")
  onboardingsPerformed                                                                         EmployeeOnboarding[]                 @relation("OnboardingAdministrator")
  employee_personal_profiles                                                                   employee_personal_profiles?
  employee_shift_assignments                                                                   employee_shift_assignments[]
  business_units_employees_business_unit_idTobusiness_units                                    business_units?                      @relation("employees_business_unit_idTobusiness_units", fields: [business_unit_id], references: [id])
  departments_employees_department_idTodepartments                                             departments?                         @relation("employees_department_idTodepartments", fields: [department_id], references: [id])
  designations                                                                                 designations?                        @relation(fields: [designation_id], references: [id])
  manager                                                                                      Employee?                            @relation("EmployeeHierarchy", fields: [managerId], references: [id], onUpdate: NoAction)
  directReports                                                                                Employee[]                           @relation("EmployeeHierarchy")
  organizations                                                                                organizations?                       @relation(fields: [organization_id], references: [id])
  work_locations                                                                               work_locations?                      @relation(fields: [work_location_id], references: [id])
  helpDeskTickets                                                                              HelpDeskTicket[]                     @relation("TicketSubmitter")
  resolvedTickets                                                                              HelpDeskTicket[]                     @relation("TicketResolver")
  interview_feedback                                                                           interview_feedback[]
  interview_panel_members                                                                      interview_panel_members[]
  lateClockInRequests                                                                          LateClockInRequest[]                 @relation("EmployeeLateRequests")
  reviewedLateRequests                                                                         LateClockInRequest[]                 @relation("HRLateReviews")
  leave_approval_steps                                                                         leave_approval_steps[]
  leaveBalances                                                                                LeaveBalance[]
  leaveRequests                                                                                LeaveRequest[]                       @relation("EmployeeLeaveRequests")
  reviewedLeaveRequests                                                                        LeaveRequest[]                       @relation("ReviewerLeaveRequests")
  leadTeams                                                                                    ManagedTeam[]                        @relation("TeamLeader")
  managedTeams                                                                                 ManagedTeam[]                        @relation("TeamManager")
  meetingInvitations                                                                           MeetingAttendee[]
  organizedMeetings                                                                            Meeting[]                            @relation("MeetingOrganizer")
  onboarding_stage_history                                                                     onboarding_stage_history[]
  onboarding_tasks_onboarding_tasks_assignee_idToemployees                                     OnboardingTask[]                     @relation("onboarding_tasks_assignee_idToemployees")
  onboarding_tasks_onboarding_tasks_completed_by_idToemployees                                 OnboardingTask[]                     @relation("onboarding_tasks_completed_by_idToemployees")
  overtimeRequests                                                                             OvertimeRequest[]
  overtime_requests_overtime_requests_reviewer_idToemployees                                   OvertimeRequest[]                    @relation("overtime_requests_reviewer_idToemployees")
  payslips                                                                                     Payslip[]
  performance_calibration_ratings                                                              performance_calibration_ratings[]
  performance_competency_assessments_performance_competency_assessments_assessor_idToemployees performance_competency_assessments[] @relation("performance_competency_assessments_assessor_idToemployees")
  performance_competency_assessments_performance_competency_assessments_employee_idToemployees performance_competency_assessments[] @relation("performance_competency_assessments_employee_idToemployees")
  performance_feedback_performance_feedback_author_idToemployees                               performance_feedback[]               @relation("performance_feedback_author_idToemployees")
  performance_feedback_performance_feedback_recipient_idToemployees                            performance_feedback[]               @relation("performance_feedback_recipient_idToemployees")
  performance_goals_performance_goals_created_by_idToemployees                                 PerformanceGoal[]                    @relation("performance_goals_created_by_idToemployees")
  performance_goals_performance_goals_owner_employee_idToemployees                             PerformanceGoal[]                    @relation("performance_goals_owner_employee_idToemployees")
  performance_improvement_plans_performance_improvement_plans_employee_idToemployees           performance_improvement_plans[]      @relation("performance_improvement_plans_employee_idToemployees")
  performance_improvement_plans_performance_improvement_plans_manager_idToemployees            performance_improvement_plans[]      @relation("performance_improvement_plans_manager_idToemployees")
  createdKras                                                                                  PerformanceKra[]                     @relation("KraAssigner")
  assignedKras                                                                                 PerformanceKra[]                     @relation("KraAssignee")
  performance_recommendations_performance_recommendations_employee_idToemployees               performance_recommendations[]        @relation("performance_recommendations_employee_idToemployees")
  performance_recommendations_performance_recommendations_recommender_idToemployees            performance_recommendations[]        @relation("performance_recommendations_recommender_idToemployees")
  performance_review_assignments_performance_review_assignments_employee_idToemployees         performance_review_assignments[]     @relation("performance_review_assignments_employee_idToemployees")
  performance_review_assignments_performance_review_assignments_reviewer_idToemployees         performance_review_assignments[]     @relation("performance_review_assignments_reviewer_idToemployees")
  policyAcknowledgements                                                                       PolicyAcknowledgement[]
  recruitment_candidates                                                                       RecruitmentCandidate[]
  recruitment_job_approvals                                                                    recruitment_job_approvals[]
  recruitment_offer_approvals                                                                  recruitment_offer_approvals[]
  teamMemberMetadataAsEmp                                                                      TeamMemberMetadata[]                 @relation("MetadataEmployee")
  teamMemberMetadataAsMgr                                                                      TeamMemberMetadata[]                 @relation("MetadataManager")
  teamMemberships                                                                              TeamMember[]
  timesheets_timesheets_employee_idToemployees                                                 timesheets[]                         @relation("timesheets_employee_idToemployees")
  timesheets_timesheets_reviewer_idToemployees                                                 timesheets[]                         @relation("timesheets_reviewer_idToemployees")
  performance_kpis                                                                             performance_kpis[]
  career_aspirations                                                                           career_aspirations?
  talent_pool_members                                                                          talent_pool_members[]
  incumbent_successions                                                                        succession_plans[]                   @relation("IncumbentSuccession")
  emergency_successions                                                                        succession_plans[]                   @relation("EmergencySuccession")
  hiring_jobs                                                                                  RecruitmentJob[]                     @relation("JobHiringManager")
  recruiting_jobs                                                                              RecruitmentJob[]                     @relation("JobRecruiter")
  assigned_candidates                                                                          RecruitmentCandidate[]               @relation("CandidateAssignedRecruiter")
  candidate_stage_changes                                                                      candidate_stage_history[]            @relation("StageHistoryChangedBy")
  conversationsAsP1                                                                            Conversation[]                       @relation("ConversationParticipant1")
  conversationsAsP2                                                                            Conversation[]                       @relation("ConversationParticipant2")
  sentMessages                                                                                 Message[]                            @relation("SentMessages")
  receivedMessages                                                                             Message[]                            @relation("ReceivedMessages")

  @@index([department_id, designation_id])
  @@index([organization_id, business_unit_id])
  @@index([work_location_id])
  @@map("employees")
}

model AuthAccount {
  id                String   @id @default(cuid())
  employeeId        String   @map("employee_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refreshToken      String?  @map("refresh_token")
  accessToken       String?  @map("access_token")
  expiresAt         Int?     @map("expires_at")
  tokenType         String?  @map("token_type")
  scope             String?
  idToken           String?  @map("id_token")
  sessionState      String?  @map("session_state")
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([employeeId])
  @@map("auth_accounts")
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  employeeId   String   @map("employee_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([expires])
  @@map("auth_sessions")
}

model AuthVerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("auth_verification_tokens")
}

model AttendanceRecord {
  id          String           @id @default(cuid()) @db.VarChar(36)
  employeeId  String           @map("employee_id") @db.VarChar(36)
  date        String           @db.VarChar(30)
  checkIn     String           @map("check_in") @db.VarChar(20)
  checkOut    String           @map("check_out") @db.VarChar(20)
  hoursWorked String           @default("0h 0m") @map("hours_worked") @db.VarChar(20)
  status      AttendanceStatus @default(OnTime)
  location    String           @default("Office - HQ") @db.VarChar(100)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId, date], map: "idx_attendance_emp_date")
  @@map("attendance_records")
}

model LateClockInRequest {
  id           String            @id @default(cuid()) @db.VarChar(36)
  requesterId  String            @map("requester_id") @db.VarChar(36)
  requestDate  String            @map("request_date") @db.VarChar(30)
  reason       String
  status       LateClockInStatus @default(pending)
  requestedAt  String            @map("requested_at") @db.VarChar(50)
  reviewedById String?           @map("reviewed_by_id") @db.VarChar(36)
  reviewedAt   String?           @map("reviewed_at") @db.VarChar(50)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  requester    Employee          @relation("EmployeeLateRequests", fields: [requesterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewedBy   Employee?         @relation("HRLateReviews", fields: [reviewedById], references: [id], onUpdate: NoAction)

  @@index([requesterId, requestDate], map: "idx_late_clockin_requester")
  @@map("late_clock_in_requests")
}

model LeaveBalance {
  id         String    @id @default(cuid()) @db.VarChar(36)
  employeeId String    @map("employee_id") @db.VarChar(36)
  year       Int       @default(2026)
  leaveType  LeaveType @map("leave_type")
  total      Int
  used       Int       @default(0)
  remaining  Int
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([employeeId, year, leaveType], map: "uq_leave_balance_emp_year_type")
  @@map("leave_balances")
}

model LeaveRequest {
  id                   String                 @id @default(cuid()) @db.VarChar(36)
  employeeId           String                 @map("employee_id") @db.VarChar(36)
  leaveType            LeaveType              @map("leave_type")
  startDate            String                 @map("start_date") @db.VarChar(30)
  endDate              String                 @map("end_date") @db.VarChar(30)
  days                 Int
  reason               String
  status               LeaveRequestStatus     @default(Pending)
  appliedOn            String                 @map("applied_on") @db.VarChar(30)
  reviewerId           String?                @map("reviewer_id") @db.VarChar(36)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  leave_approval_steps leave_approval_steps[]
  employee             Employee               @relation("EmployeeLeaveRequests", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviewer             Employee?              @relation("ReviewerLeaveRequests", fields: [reviewerId], references: [id], onUpdate: NoAction)

  @@index([employeeId, status], map: "idx_leave_req_emp_status")
  @@map("leave_requests")
}

model ManagedTeam {
  id                String            @id @db.VarChar(36)
  name              String            @db.VarChar(100)
  department        String            @db.VarChar(80)
  managerId         String            @map("manager_id") @db.VarChar(36)
  leaderId          String            @map("leader_id") @db.VarChar(36)
  focus             String
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  leader            Employee          @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  manager           Employee          @relation("TeamManager", fields: [managerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  performance_goals PerformanceGoal[]
  members           TeamMember[]

  @@map("managed_teams")
}

model TeamMember {
  id         String      @id @default(cuid()) @db.VarChar(36)
  teamId     String      @map("team_id") @db.VarChar(36)
  employeeId String      @map("employee_id") @db.VarChar(36)
  joinedAt   DateTime    @default(now()) @map("joined_at") @db.Timestamptz(6)
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  team       ManagedTeam @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teamId, employeeId], map: "uq_team_member")
  @@map("team_members")
}

model TeamMemberMetadata {
  id           String   @id @default(cuid()) @db.VarChar(36)
  employeeId   String   @map("employee_id") @db.VarChar(36)
  managerId    String   @map("manager_id") @db.VarChar(36)
  focus        String
  workload     Int      @default(70)
  goalProgress Int      @default(60) @map("goal_progress")
  goalLabel    String   @map("goal_label") @db.VarChar(150)
  nextOneToOne String   @map("next_one_to_one") @db.VarChar(50)
  risk         TeamRisk @default(OnTrack)
  notes        String
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  employee     Employee @relation("MetadataEmployee", fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  manager      Employee @relation("MetadataManager", fields: [managerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([employeeId, managerId], map: "uq_team_metadata_emp_mgr")
  @@map("team_member_metadata")
}

model Meeting {
  id              String            @id @db.VarChar(36)
  title           String            @db.VarChar(150)
  type            MeetingType       @default(TEAM)
  description     String?
  startsAt        DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime          @map("ends_at") @db.Timestamptz(6)
  allDay          Boolean           @default(false) @map("all_day")
  location        String?           @db.VarChar(150)
  videoLink       String?           @map("video_link") @db.VarChar(255)
  organizerId     String            @map("organizer_id") @db.VarChar(36)
  department      String?           @db.VarChar(80)
  recurrence      Recurrence        @default(NONE)
  reminderMinutes Int?              @default(15) @map("reminder_minutes")
  status          MeetingStatus     @default(UPCOMING)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  attendees       MeetingAttendee[]
  organizer       Employee          @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([startsAt, endsAt], map: "idx_meetings_times")
  @@map("meetings")
}

model MeetingAttendee {
  id             String     @id @default(cuid()) @db.VarChar(36)
  meetingId      String     @map("meeting_id") @db.VarChar(36)
  employeeId     String     @map("employee_id") @db.VarChar(36)
  rsvp           RsvpStatus @default(PENDING)
  responseReason String?    @map("response_reason") @db.VarChar(500)
  updatedAt      DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  meeting        Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([meetingId, employeeId], map: "uq_meeting_attendee")
  @@map("meeting_attendees")
}

model Payslip {
  id               String        @id @db.VarChar(36)
  employeeId       String        @map("employee_id") @db.VarChar(36)
  monthYear        String        @map("month_year") @db.VarChar(30)
  basicSalary      Decimal       @map("basic_salary") @db.Decimal(10, 2)
  hra              Decimal       @db.Decimal(10, 2)
  conveyance       Decimal       @db.Decimal(10, 2)
  specialAllowance Decimal       @map("special_allowance") @db.Decimal(10, 2)
  pfDeduction      Decimal       @map("pf_deduction") @db.Decimal(10, 2)
  taxDeduction     Decimal       @map("tax_deduction") @db.Decimal(10, 2)
  grossEarnings    Decimal       @map("gross_earnings") @db.Decimal(10, 2)
  totalDeductions  Decimal       @map("total_deductions") @db.Decimal(10, 2)
  netPayable       Decimal       @map("net_payable") @db.Decimal(10, 2)
  paymentDate      String        @map("payment_date") @db.VarChar(50)
  status           PayslipStatus @default(Paid)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([employeeId, monthYear], map: "uq_payslip_emp_month")
  @@map("payslips")
}

model PerformanceKra {
  id           String      @id @db.VarChar(36)
  title        String      @db.VarChar(200)
  description  String
  keyResult    String      @map("key_result")
  category     String      @db.VarChar(80)
  assignedToId String      @map("assigned_to_id") @db.VarChar(36)
  assignedById String      @map("assigned_by_id") @db.VarChar(36)
  assignedOn   String      @map("assigned_on") @db.VarChar(30)
  dueDate      String      @map("due_date") @db.VarChar(30)
  priority     KraPriority @default(Medium)
  status       KraStatus   @default(NotStarted)
  progress     Int         @default(0)
  weightage    Int         @default(20)
  lastUpdate   String?     @map("last_update")
  deliverables String[]    @default([])
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignedBy   Employee    @relation("KraAssigner", fields: [assignedById], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignedTo   Employee    @relation("KraAssignee", fields: [assignedToId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assignedToId, status], map: "idx_kras_assigned_status")
  @@map("performance_kras")
}

model PerformanceGoal {
  id                                                       String            @id @default(cuid())
  organization_id                                          String
  department_id                                            String?
  team_id                                                  String?
  owner_employee_id                                        String?
  parentGoalId                                             String?           @map("parent_goal_id")
  created_by_id                                            String
  type                                                     GoalType
  scope                                                    GoalScope
  title                                                    String
  description                                              String?
  metric                                                   String?
  targetValue                                              Decimal?          @map("target_value") @db.Decimal(14, 2)
  currentValue                                             Decimal?          @map("current_value") @db.Decimal(14, 2)
  progress                                                 Int               @default(0)
  weightage                                                Int               @default(0)
  cycle_id                                                 String?           @map("cycle_id")
  start_date                                               DateTime          @db.Date
  due_date                                                 DateTime          @db.Date
  status                                                   GoalStatus        @default(Draft)
  createdAt                                                DateTime          @default(now()) @map("created_at")
  updatedAt                                                DateTime          @updatedAt @map("updated_at")
  employees_performance_goals_created_by_idToemployees     Employee          @relation("performance_goals_created_by_idToemployees", fields: [created_by_id], references: [id])
  departments                                              departments?      @relation(fields: [department_id], references: [id])
  organizations                                            organizations     @relation(fields: [organization_id], references: [id])
  employees_performance_goals_owner_employee_idToemployees Employee?         @relation("performance_goals_owner_employee_idToemployees", fields: [owner_employee_id], references: [id])
  performance_goals                                        PerformanceGoal?  @relation("performance_goalsToperformance_goals", fields: [parentGoalId], references: [id])
  other_performance_goals                                  PerformanceGoal[] @relation("performance_goalsToperformance_goals")
  managed_teams                                            ManagedTeam?      @relation(fields: [team_id], references: [id])
  key_results                                              performance_key_results[]

  @@index([organization_id, scope, status])
  @@index([owner_employee_id, status])
  @@index([parentGoalId])
  @@map("performance_goals")
}

model RecruitmentJob {
  id                        String                      @id @db.VarChar(36)
  title                     String                      @db.VarChar(150)
  department                String                      @db.VarChar(80)
  location                  String                      @db.VarChar(100)
  employmentType            JobEmploymentType           @default(FullTime) @map("employment_type")
  openings                  Int                         @default(1)
  applicants                Int                         @default(0)
  status                    JobStatus                   @default(Open)
