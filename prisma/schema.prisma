  content_snapshot            String?
  sent_at                     DateTime?
  viewed_at                   DateTime?
  responded_at                DateTime?
  created_at                  DateTime                      @default(now())
  updated_at                  DateTime
  document_signatures         document_signatures[]
  employee_onboardings        EmployeeOnboarding?
  recruitment_offer_approvals recruitment_offer_approvals[]
  recruitment_candidates      RecruitmentCandidate          @relation(fields: [candidate_id], references: [id])
  document_templates          DocumentTemplate?             @relation(fields: [template_id], references: [id])

  @@unique([candidate_id, version])
  @@index([status, expires_at])
  @@index([template_id])
}

model timesheets {
  id                                          String              @id
  employee_id                                 String
  project_id                                  String?
  work_date                                   DateTime            @db.Date
  expected_minutes                            Int                 @default(0)
  logged_minutes                              Int
  billable_minutes                            Int                 @default(0)
  description                                 String?
  status                                      TimesheetStatus     @default(Draft)
  reviewer_id                                 String?
  reviewed_at                                 DateTime?
  created_at                                  DateTime            @default(now())
  updated_at                                  DateTime
