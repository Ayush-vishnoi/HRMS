  @@index([approver_id, status])
}

model recruitment_offers {
  id                          String                        @id
  candidate_id                String
  template_id                 String?
  status                      RecruitmentOfferStatus        @default(Draft)
  version                     Int                           @default(1)
  offered_title               String
